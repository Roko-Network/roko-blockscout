# docker-compose-level secrets for the roko-explorer deployment.
# Copy to `.env` (which is gitignored) and fill in real values before running
# `docker compose up -d`. Rotate secrets on every fresh deploy.

# Postgres superuser password. Must also appear in envs/backend.env's
# DATABASE_URL (blockscout role) — the values for blockscout/roko_indexer
# roles are seeded by deploy/sql/init-roko-schema.sql at first boot.
POSTGRES_PASSWORD=replace-with-strong-secret

# Password for the dedicated `roko_indexer` Postgres role created by
# init-roko-schema.sql. The sidecar uses this; the blockscout role uses
# POSTGRES_PASSWORD via DATABASE_URL in envs/backend.env.
ROKO_INDEXER_DB_PASSWORD=replace-with-strong-secret

# Image tag for the roko-indexer-sidecar. Override to pin a specific build.
# Default: ghcr.io/roko-network/roko-indexer:testnet-latest-amd64
# ROKO_INDEXER_IMAGE=ghcr.io/roko-network/roko-indexer:testnet-v0.1.0-amd64

# Roko RPC the sidecar subscribes to. Must be an archive node.
# ROKO_RPC_WS_URL=wss://roko-testnetv2.ntfork.com
# ROKO_RPC_FALLBACK_URL=ws://13.51.27.22:9944

# Starting block for the indexer when the cursor table is empty.
# INDEXER_START_BLOCK=0

# Sidecar log filter + format.
# ROKO_INDEXER_RUST_LOG=info,roko_indexer_sidecar=debug
# ROKO_INDEXER_LOG_FORMAT=json
