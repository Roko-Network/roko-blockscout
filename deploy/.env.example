# docker-compose-level secrets for the roko-explorer deployment.
# Copy to `.env` (which is gitignored) and fill in real values before running
# `docker compose up -d`. Rotate secrets on every fresh deploy.

# Postgres superuser password. Must also appear in envs/backend.env's
# DATABASE_URL (blockscout role) — the values for blockscout/roko_indexer
# roles are seeded by deploy/sql/init-roko-schema.sql at first boot.
POSTGRES_PASSWORD=replace-with-strong-secret

# Password for the dedicated `roko_indexer` Postgres role created by
# init-roko-schema.sql. The sidecar uses this; the blockscout role uses
# POSTGRES_PASSWORD via DATABASE_URL in envs/backend.env.
ROKO_INDEXER_DB_PASSWORD=replace-with-strong-secret

# Image tag for the roko-indexer-sidecar. Override to pin a specific build.
# Default: git.integrolabs.net/roko/roko-indexer:testnet
# ROKO_INDEXER_IMAGE=git.integrolabs.net/roko/roko-indexer:sha-<commit>

# Roko RPC the sidecar subscribes to. The reviewed boe proxy is bound to the
# fleet network and accepts only apps01; the validator RPC stays loopback-only.
ROKO_RPC_WS_URL=ws://127.0.0.1:9945
# CMDB address used for boe.s9.internal inside the indexer's Docker namespace.
ROKO_RPC_HOST_IP=10.0.42.97
# ROKO_RPC_FALLBACK_URL=

# A chain cutover must use fresh volumes so data from another genesis is never
# mixed into this deployment. Preserve the old named volumes for rollback.
ROKO_POSTGRES_VOLUME=roko-blockscout-postgres-v52370
ROKO_REDIS_VOLUME=roko-blockscout-redis-v52370

# Starting block for the indexer when the cursor table is empty. Use 0 only
# with an archive node. For a pruned validator, record and use the finalized
# head at cutover so the sidecar does not request discarded historical state.
# INDEXER_START_BLOCK=<finalized-head-at-cutover>

# Sidecar log filter + format.
# ROKO_INDEXER_RUST_LOG=info,roko_indexer_sidecar=debug
# ROKO_INDEXER_LOG_FORMAT=json

# CI-built images (deploy-by-pull). Default to the moving :testnet tag; override
# to pin a specific sha- tag from the build pipeline.
# ROKO_BACKEND_IMAGE=git.integrolabs.net/roko/roko-blockscout-backend:testnet
# ROKO_FRONTEND_IMAGE=git.integrolabs.net/roko/roko-blockscout-frontend:testnet
