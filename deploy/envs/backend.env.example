ETHEREUM_JSONRPC_VARIANT=geth
ETHEREUM_JSONRPC_HTTP_URL=http://boe.s9.internal:9945/
ETHEREUM_JSONRPC_TRACE_URL=http://boe.s9.internal:9945/
ETHEREUM_JSONRPC_WS_URL=ws://boe.s9.internal:9945/
ETHEREUM_JSONRPC_TRANSPORT=http
ETHEREUM_JSONRPC_DISABLE_ARCHIVE_BALANCES=false
DISABLE_FILE_LOGGING=false
# Must match POSTGRES_PASSWORD in ../.env (the docker-compose root .env).
DATABASE_URL=postgresql://blockscout:replace-with-strong-secret@db:5432/blockscout
NETWORK=Roko
SUBNETWORK=Mainnet-Configured Test
CHAIN_ID=52370
COIN=ROKO
COIN_NAME=ROKO
LOGO=/images/roko-logo.png
SUPPORTED_CHAINS=[]
BLOCK_TRANSFORMER=base
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=true
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=true
FETCH_REWARDS_WAY=manual
DISABLE_EXCHANGE_RATES=true
DISABLE_KNOWN_TOKENS=true
SHOW_TXS_CHART=true
ENABLE_TXS_STATS=true
HISTORY_FETCH_INTERVAL=30
TXS_HISTORIAN_INIT_LAG=0
TXS_STATS_DAYS_TO_COMPILE_AT_INIT=10
POOL_SIZE=20
POOL_SIZE_API=10
ECTO_USE_SSL=false
HEART_BEAT_TIMEOUT=30
API_V2_ENABLED=true

# --- Reverse-proxy real-IP (roko/roko-blockscout#2) ---
# The backend runs behind nginx + cloudflared/npm01. Derive the real client IP
# from X-Forwarded-For so the per-IP rate limiter attributes real clients, not
# the proxy. WITHOUT this the default API_RATE_LIMIT_BY_IP (300/1m) is applied to
# every request as one IP, capping the whole public API at ~5 req/s. nginx must
# also resolve the real IP (deploy/nginx/default.conf realip block).
API_RATE_LIMIT_IS_BLOCKSCOUT_BEHIND_PROXY=true
API_RATE_LIMIT_REMOTE_IP_HEADERS=x-forwarded-for
# --- Conservative QoS rate limiting (roko/roko-blockscout#3) ---
# POOL_SIZE trimmed 40 -> 20 above (F5) to protect the shared HDD-backed DB.
# Redis-backed limiter so counters survive backend restarts and are shared
# across API workers (reuses the existing redis-db service; DB index 1). (F4)
API_RATE_LIMIT_HAMMER_REDIS_URL=redis://redis-db:6379/1
# Per-IP: 120 req/min (~2 req/s), 1-minute window tolerates page bursts. Only
# meaningful with the realip fix + behind-proxy (above); without real client IPs
# this caps ALL traffic collectively. Verify realip on apps01 before relying on it.
API_RATE_LIMIT_BY_IP=120
API_RATE_LIMIT_BY_IP_TIME_INTERVAL=1m
# Higher allowance for our own frontend/integrators via a static API key; keep the
# limiter ENABLED. Generate a real key (openssl rand -hex 24) into the deployed
# envs/backend.env — do NOT commit the value.
API_RATE_LIMIT_STATIC_API_KEY=replace-with-generated-key
API_RATE_LIMIT_BY_KEY=1000
API_RATE_LIMIT_BY_KEY_TIME_INTERVAL=1m
